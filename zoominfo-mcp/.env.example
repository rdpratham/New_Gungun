# ZoomInfo API credentials
# Option A — Client ID + RSA private key (recommended for production)
ZOOMINFO_CLIENT_ID=your_client_id_here
ZOOMINFO_PRIVATE_KEY=your_rsa_private_key_here

# Option B — Username + password (simpler, for development)
ZOOMINFO_USERNAME=your_email@example.com
ZOOMINFO_PASSWORD=your_password_here
