# Microsoft Azure App Registration credentials
# Register at https://portal.azure.com -> Azure Active Directory -> App registrations
AZURE_CLIENT_ID=your-client-id-here
AZURE_TENANT_ID=your-tenant-id-here
# For delegated (user) auth: leave CLIENT_SECRET blank and use device-code flow
# For app-only auth: set CLIENT_SECRET
AZURE_CLIENT_SECRET=

# Optional: path to store the SQLite database (default: ./mail_store.db)
DB_PATH=./mail_store.db

# Optional: embedding model (default uses sentence-transformers all-MiniLM-L6-v2)
# Set to "none" to disable semantic search and use keyword-only search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: max emails to sync per folder on first run (0 = unlimited)
SYNC_LIMIT=0

# Optional: log file path (default: ./agent.log)
LOG_PATH=./agent.log
