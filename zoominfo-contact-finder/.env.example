# Copy this file to .env and fill in your own values. Never commit .env.

# Base URL for the ZoomInfo API your account is provisioned for.
# Confirm the exact value in your ZoomInfo Developer Portal contract.
ZOOMINFO_API_BASE_URL=https://api.zoominfo.com

# --- Option A: username/password authentication ---
ZOOMINFO_USERNAME=
ZOOMINFO_PASSWORD=

# --- Option B: PKI (client id + private key) authentication ---
# Use this instead of username/password if your ZoomInfo contract issues PKI credentials.
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=

# Local server port
PORT=4000
