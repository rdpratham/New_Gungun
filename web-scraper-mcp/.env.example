# Required: your Anthropic API key for AI-powered extraction
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model used for extraction (defaults to claude-sonnet-4-20250514)
# EXTRACTION_MODEL=claude-sonnet-4-20250514

# Optional: logging level (error | warn | info | http | verbose | debug)
# LOG_LEVEL=info

# Optional: write logs to a file (in addition to stderr)
# LOG_FILE=/tmp/web-scraper-mcp.log

# Optional: minimum delay in ms between requests to the same host (default 1000)
# SCRAPE_DELAY_MS=1000

# Optional: directory where scrape_and_save writes files (default ./scraped_output)
# SCRAPE_OUTPUT_DIR=./scraped_output
